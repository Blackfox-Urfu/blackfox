{
  "manifest_version": 3,
  "name": "Telegram Content Filter & NSFW Avatar Classifier",
  "version": "1.2.0",
  "description": "Filters ads and classifies user avatars (NSFW/SFW) in Telegram Web.",
  "options_page": "popup.html",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.telegram.org/*",
    "http://localhost:8000/"   
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/a/*",
        "https://web.telegram.org/k/*",
        "https://web.telegram.org/z/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TG Filter Settings"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}