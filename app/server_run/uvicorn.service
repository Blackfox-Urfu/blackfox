[Unit]
Description=Uvicorn FastAPI application
After=network.target

[Service]
ExecStart=/root/.cache/pypoetry/virtualenvs/blackfox-FAJo6lti-py3.12/bin/uvicorn app.server_run.main:app \
    --host 0.0.0.0 --port 8000 \
    --ssl-keyfile /etc/letsencrypt/live/blackfoxus.ru/privkey.pem \
    --ssl-certfile /etc/letsencrypt/live/blackfoxus.ru/fullchain.pem
Environment="PYTHONPATH=/root/blackfox"
WorkingDirectory=/root/blackfox
User=root
Group=root
Restart=always

PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=slut_detector

[Install]
WantedBy=multi-user.target


