        { "expr": "sum(rate(predictions_total{job=\"fastapi-app\", model_type=~\"multimodal|text_only\"}[5m])) by (result)", "refId": "A", "legendFormat": "{{result}}" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 20, "gradientMode": "opacity", "stacking": { "mode": "normal" } }, "unit": "reqps" } }
    },
